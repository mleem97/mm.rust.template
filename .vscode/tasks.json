{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--workspace", "--all-targets", "--locked"],
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace", "--all-features", "--locked"],
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--workspace", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "problemMatcher": "$rustc"
    }
  ]
}
