{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mm-rust-template/task-graph.schema.json",
  "title": "AI Task Graph",
  "type": "object",
  "required": ["schema_version", "graph_id", "source", "nodes"],
  "properties": {
    "schema_version": {"type": "string"},
    "graph_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["documents"],
      "properties": {"documents": {"type": "array", "items": {"type": "string"}}}
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "dependencies", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "type": {"enum": ["analysis", "decision", "code_edit", "test", "documentation", "deployment", "review", "approval", "finalizer"]},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_capabilities": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}
        }
      }
    }
  }
}
